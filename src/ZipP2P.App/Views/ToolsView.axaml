<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZipP2P.App.ViewModels"
             xmlns:views="using:ZipP2P.App.Views"
             xmlns:loc="using:ZipP2P.App.Localization"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="ZipP2P.App.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="0,4,4,4">
            <TextBlock Classes="hint" Text="{Binding [Tools.Hint], Source={x:Static loc:Localizer.Instance}}" />

            <ContentControl Classes="dashed" IsEnabled="{Binding !IsBusy}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Classes="label" Text="{Binding [Label.Mode], Source={x:Static loc:Localizer.Instance}}" />
                            <ComboBox SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{Binding [Mode.Compress], Source={x:Static loc:Localizer.Instance}}" />
                                <ComboBoxItem Content="{Binding [Mode.Decompress], Source={x:Static loc:Localizer.Instance}}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding IsCompressMode}">
                            <TextBlock Classes="label" Text="{Binding [Label.CompressionLevel], Source={x:Static loc:Localizer.Instance}}" />
                            <ComboBox SelectedIndex="{Binding CompressionPresetIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{Binding [Level.Fast], Source={x:Static loc:Localizer.Instance}}" />
                                <ComboBoxItem Content="{Binding [Level.Balanced], Source={x:Static loc:Localizer.Instance}}" />
                                <ComboBoxItem Content="{Binding [Level.Maximum], Source={x:Static loc:Localizer.Instance}}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{Binding [Label.InputFile], Source={x:Static loc:Localizer.Instance}}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding InputPath}" IsReadOnly="True" VerticalContentAlignment="Center"
                                     PlaceholderText="{Binding [Tools.InputPlaceholder], Source={x:Static loc:Localizer.Instance}}" />
                            <Button AutomationProperties.Name="{Binding [Send.PickFile], Source={x:Static loc:Localizer.Instance}}" Grid.Column="1" Command="{Binding PickFileCommand}"
                                    ToolTip.Tip="{Binding [Send.PickFile], Source={x:Static loc:Localizer.Instance}}">
                                <icons:MaterialIcon Kind="FileOutline" Width="18" Height="18" />
                            </Button>
                            <Button AutomationProperties.Name="{Binding [Send.PickFolder], Source={x:Static loc:Localizer.Instance}}" Grid.Column="2" Command="{Binding PickFolderCommand}" IsVisible="{Binding IsCompressMode}"
                                    ToolTip.Tip="{Binding [Send.PickFolder], Source={x:Static loc:Localizer.Instance}}">
                                <icons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{Binding [Receive.SaveTo], Source={x:Static loc:Localizer.Instance}}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding OutputDir}" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding PickOutputCommand}" AutomationProperties.Name="{Binding [Receive.Change], Source={x:Static loc:Localizer.Instance}}" ToolTip.Tip="{Binding [Receive.Change], Source={x:Static loc:Localizer.Instance}}">
                                <icons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Button AutomationProperties.Name="{Binding [Action.Start], Source={x:Static loc:Localizer.Instance}}" Classes="primary large" Command="{Binding StartCommand}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Action.Start], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ContentControl>

            <views:StatusPanel />

            <Button AutomationProperties.Name="{Binding [Action.Cancel], Source={x:Static loc:Localizer.Instance}}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" MinWidth="120" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [Action.Cancel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
