<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZipP2P.App.ViewModels"
        xmlns:loc="using:ZipP2P.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ZipP2P.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="760" Height="560"
        MinWidth="640" MinHeight="480"
        Title="{Binding [App.Title], Source={x:Static loc:Localizer.Instance}}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="28" RowSpacing="16">

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding [App.Title], Source={x:Static loc:Localizer.Instance}}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding [Settings.Language], Source={x:Static loc:Localizer.Instance}}"
                           VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding LanguageIndex}" MinWidth="160">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="Português (Brasil)" />
                    <ComboBoxItem Content="Español" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Área de drop -->
        <Border Grid.Row="1" Height="120" CornerRadius="8"
                BorderThickness="1" BorderBrush="#33FFFFFF" Background="#14FFFFFF">
            <TextBlock Text="{Binding [Home.DropHint], Source={x:Static loc:Localizer.Instance}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.7" />
        </Border>

        <!-- Modo + nível de compressão -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding [Label.Mode], Source={x:Static loc:Localizer.Instance}}"
                       VerticalAlignment="Center" />
            <ComboBox SelectedIndex="{Binding ModeIndex}" MinWidth="160">
                <ComboBoxItem Content="{Binding [Mode.Compress], Source={x:Static loc:Localizer.Instance}}" />
                <ComboBoxItem Content="{Binding [Mode.Decompress], Source={x:Static loc:Localizer.Instance}}" />
            </ComboBox>
            <TextBlock Text="{Binding [Label.CompressionLevel], Source={x:Static loc:Localizer.Instance}}"
                       VerticalAlignment="Center" Margin="24,0,0,0"
                       IsVisible="{Binding IsCompressMode}" />
            <ComboBox SelectedIndex="{Binding CompressionPresetIndex}" MinWidth="160"
                      IsVisible="{Binding IsCompressMode}">
                <ComboBoxItem Content="{Binding [Level.Fast], Source={x:Static loc:Localizer.Instance}}" />
                <ComboBoxItem Content="{Binding [Level.Balanced], Source={x:Static loc:Localizer.Instance}}" />
                <ComboBoxItem Content="{Binding [Level.Maximum], Source={x:Static loc:Localizer.Instance}}" />
            </ComboBox>
        </StackPanel>

        <!-- Arquivo de entrada -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding [Label.InputFile], Source={x:Static loc:Localizer.Instance}}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding InputPath}"
                     IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Margin="10,0,0,0"
                    Content="{Binding [Action.Browse], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding BrowseInputCommand}" />
        </Grid>

        <!-- Arquivo de saída -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding [Label.OutputFile], Source={x:Static loc:Localizer.Instance}}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding OutputPath}"
                     IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Margin="10,0,0,0"
                    Content="{Binding [Action.Browse], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding BrowseOutputCommand}" />
        </Grid>

        <!-- Progresso -->
        <StackPanel Grid.Row="5" Spacing="8">
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1" Text="{Binding Details}" Opacity="0.7" />
            </Grid>
        </StackPanel>

        <!-- Ações -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{Binding [Action.Cancel], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding CancelCommand}" />
            <Button Content="{Binding [Action.Start], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding StartCommand}"
                    Classes="accent" />
        </StackPanel>

    </Grid>

</Window>
