<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZipP2P.App.ViewModels"
        xmlns:loc="using:ZipP2P.App.Localization"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="660"
        x:Class="ZipP2P.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="760" Height="660"
        MinWidth="640" MinHeight="580"
        Title="{Binding [App.Title], Source={x:Static loc:Localizer.Instance}}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="32" RowSpacing="20">

        <!-- Cabeçalho: título à esquerda, idioma à direita -->
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding [App.Title], Source={x:Static loc:Localizer.Instance}}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="Language" IconSize="20" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox SelectedIndex="{Binding LanguageIndex}" MinWidth="160">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="Português (Brasil)" />
                    <ComboBoxItem Content="Español" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Dropzone -->
        <Border Grid.Row="1" Height="168" CornerRadius="12"
                BorderThickness="1.5" BorderBrush="#3AFFFFFF" Background="#12FFFFFF">
            <StackPanel Orientation="Vertical" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="CloudUpload" IconSize="56"
                                    HorizontalAlignment="Center" Opacity="0.85" />
                <TextBlock Text="{Binding [Home.DropHint], Source={x:Static loc:Localizer.Instance}}"
                           HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>

        <!-- Modo + nível de compressão (lado a lado) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
                <TextBlock Text="{Binding [Label.Mode], Source={x:Static loc:Localizer.Instance}}"
                           FontSize="12" Opacity="0.7" />
                <ComboBox SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{Binding [Mode.Compress], Source={x:Static loc:Localizer.Instance}}" />
                    <ComboBoxItem Content="{Binding [Mode.Decompress], Source={x:Static loc:Localizer.Instance}}" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0"
                        IsVisible="{Binding IsCompressMode}">
                <TextBlock Text="{Binding [Label.CompressionLevel], Source={x:Static loc:Localizer.Instance}}"
                           FontSize="12" Opacity="0.7" />
                <ComboBox SelectedIndex="{Binding CompressionPresetIndex}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{Binding [Level.Fast], Source={x:Static loc:Localizer.Instance}}" />
                    <ComboBoxItem Content="{Binding [Level.Balanced], Source={x:Static loc:Localizer.Instance}}" />
                    <ComboBoxItem Content="{Binding [Level.Maximum], Source={x:Static loc:Localizer.Instance}}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Arquivo de entrada -->
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock Text="{Binding [Label.InputFile], Source={x:Static loc:Localizer.Instance}}"
                       FontSize="12" Opacity="0.7" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding InputPath}"
                         IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding BrowseInputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="FolderOpen" IconSize="16" />
                        <TextBlock Text="{Binding [Action.Browse], Source={x:Static loc:Localizer.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Arquivo de saída -->
        <StackPanel Grid.Row="4" Spacing="6">
            <TextBlock Text="{Binding [Label.OutputFile], Source={x:Static loc:Localizer.Instance}}"
                       FontSize="12" Opacity="0.7" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding OutputPath}"
                         IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding BrowseOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="FolderOpen" IconSize="16" />
                        <TextBlock Text="{Binding [Action.Browse], Source={x:Static loc:Localizer.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Progresso + status -->
        <StackPanel Grid.Row="5" Spacing="10">
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" />
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircleOutline" IconSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Details}" Opacity="0.7" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- Ações -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{Binding [Action.Cancel], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding CancelCommand}" />
            <Button Content="{Binding [Action.Start], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding StartCommand}" Classes="accent" MinWidth="120" />
        </StackPanel>

    </Grid>

</Window>
