<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZipP2P.App.ViewModels"
             xmlns:loc="using:ZipP2P.App.Localization"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="660"
             x:Class="ZipP2P.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

        <!-- Voltar -->
        <Button AutomationProperties.Name="{Binding [Settings.Back], Source={x:Static loc:Localizer.Instance}}" Grid.Row="0" Command="{Binding BackCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Settings.Back], Source={x:Static loc:Localizer.Instance}}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Servidor remoto -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [Settings.ServerUrl], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding ServerUrl}" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding [Settings.ServerUrlHint], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.8"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- STUN/TURN (relay quando a conexão direta é bloqueada) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [Settings.IceTitle], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid ColumnDefinitions="*,150,170" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding IceHost}" VerticalContentAlignment="Center"
                                 PlaceholderText="{Binding [Settings.IceHost], Source={x:Static loc:Localizer.Instance}}"
                                 AutomationProperties.Name="{Binding [Settings.IceHost], Source={x:Static loc:Localizer.Instance}}" />
                        <TextBox Grid.Column="1" Text="{Binding IceUsername}" VerticalContentAlignment="Center"
                                 PlaceholderText="{Binding [Settings.IceUsername], Source={x:Static loc:Localizer.Instance}}"
                                 AutomationProperties.Name="{Binding [Settings.IceUsername], Source={x:Static loc:Localizer.Instance}}" />
                        <TextBox Grid.Column="2" Text="{Binding IcePassword}" VerticalContentAlignment="Center" PasswordChar="•"
                                 PlaceholderText="{Binding [Settings.IcePassword], Source={x:Static loc:Localizer.Instance}}"
                                 AutomationProperties.Name="{Binding [Settings.IcePassword], Source={x:Static loc:Localizer.Instance}}" />
                    </Grid>
                    <TextBlock Text="{Binding [Settings.IceHint], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.8"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Servidor local (mesma rede) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [Settings.LocalServerHint], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding [Settings.Port], Source={x:Static loc:Localizer.Instance}}"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding Port}" Width="80" VerticalContentAlignment="Center" />
                        <Button AutomationProperties.Name="{Binding [Settings.StartServer], Source={x:Static loc:Localizer.Instance}}" Command="{Binding ToggleServerCommand}" IsVisible="{Binding IsServerStopped}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Settings.StartServer], Source={x:Static loc:Localizer.Instance}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding [Settings.StopServer], Source={x:Static loc:Localizer.Instance}}" Command="{Binding ToggleServerCommand}" IsVisible="{Binding IsServerRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Settings.StopServer], Source={x:Static loc:Localizer.Instance}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ServerStatus}" VerticalAlignment="Center" IsVisible="{Binding IsServerRunning}"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Menu de contexto do sistema ("Enviar com ZipStream") -->
                <StackPanel Spacing="8" IsVisible="{Binding IsShellSupported}">
                    <TextBlock Text="{Binding [Settings.ShellTitle], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ShellHint}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button AutomationProperties.Name="{Binding [Settings.ShellInstall], Source={x:Static loc:Localizer.Instance}}"
                                Command="{Binding InstallShellCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="CursorDefaultClick" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Settings.ShellInstall], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding [Settings.ShellRemove], Source={x:Static loc:Localizer.Instance}}"
                                Command="{Binding UninstallShellCommand}" IsEnabled="{Binding IsShellInstalled}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Settings.ShellRemove], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ShellStatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ShellNote}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.8" />
                </StackPanel>

                <!-- Bandeja do sistema -->
                <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding CloseToTray}"
                              Content="{Binding [Settings.CloseToTray], Source={x:Static loc:Localizer.Instance}}" />
                    <TextBlock Text="{Binding [Settings.CloseToTrayHint], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.8" />
                </StackPanel>

                <!-- Atualizações (releases do GitHub) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [Update.Title], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding CurrentVersion}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button AutomationProperties.Name="{Binding [Update.Check], Source={x:Static loc:Localizer.Instance}}"
                                Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding CanCheckForUpdates}"
                                IsEnabled="{Binding IsIdleForUpdates}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Update.Check], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding [Update.Install], Source={x:Static loc:Localizer.Instance}}"
                                Classes="primary" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding CanInstallUpdate}"
                                IsEnabled="{Binding IsIdleForUpdates}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Download" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Update.Install], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding [Update.OpenPage], Source={x:Static loc:Localizer.Instance}}"
                                Classes="link" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding HasUpdate}"
                                VerticalAlignment="Center"
                                Content="{Binding [Update.OpenPage], Source={x:Static loc:Localizer.Instance}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                    <CheckBox IsChecked="{Binding AutoCheckUpdates}" IsVisible="{Binding CanCheckForUpdates}"
                              Content="{Binding [Update.AutoCheck], Source={x:Static loc:Localizer.Instance}}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Salvar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.Name="{Binding [Settings.Save], Source={x:Static loc:Localizer.Instance}}" Command="{Binding SaveCommand}" Classes="primary" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [Settings.Save], Source={x:Static loc:Localizer.Instance}}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
