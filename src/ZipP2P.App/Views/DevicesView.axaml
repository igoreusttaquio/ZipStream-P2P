<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZipP2P.App.ViewModels"
             xmlns:loc="using:ZipP2P.App.Localization"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="800"
             x:Class="ZipP2P.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,4,16,4">

            <TextBlock Classes="hint" Text="{Binding [Devices.Intro], Source={x:Static loc:Localizer.Instance}}" />

            <!-- Este computador: receive mode -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <icons:MaterialIcon Grid.Column="0" Kind="Monitor" Width="20" Height="20"
                                            Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="section" Text="{Binding [Devices.ReceiveMode], Source={x:Static loc:Localizer.Instance}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsOnline}" />
                                <TextBlock Classes="hint" Text="{Binding ReceiveStatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding ReceiveModeEnabled}" OnContent="" OffContent=""
                                      AutomationProperties.Name="{Binding [Devices.ReceiveMode], Source={x:Static loc:Localizer.Instance}}"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Value="{Binding ReceiveProgress}" Minimum="0" Maximum="100" IsVisible="{Binding IsReceiving}" />

                    <!-- Código do receptor -->
                    <Border Classes="notice">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="{Binding [Devices.Code], Source={x:Static loc:Localizer.Instance}}" />
                                <SelectableTextBlock Text="{Binding ReceiverCode}" FontSize="26" FontWeight="Bold" LetterSpacing="3"
                                                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                                     Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Classes="hint" Text="{Binding [Devices.CodeHint], Source={x:Static loc:Localizer.Instance}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <Button AutomationProperties.Name="{Binding [Logs.Copy], Source={x:Static loc:Localizer.Instance}}"
                                        Command="{Binding CopyCodeCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [Logs.Copy], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="{Binding [Devices.Regenerate], Source={x:Static loc:Localizer.Instance}}"
                                        Command="{Binding RegenerateCodeCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="Autorenew" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [Devices.Regenerate], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding CopyFeedback}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nome e pasta -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Classes="label" Text="{Binding [Devices.Name], Source={x:Static loc:Localizer.Instance}}" />
                            <TextBox Text="{Binding DeviceName}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{Binding [Devices.Name], Source={x:Static loc:Localizer.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Classes="label" Text="{Binding [Receive.SaveTo], Source={x:Static loc:Localizer.Instance}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding DownloadDirectory}" IsReadOnly="True" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{Binding [Receive.SaveTo], Source={x:Static loc:Localizer.Instance}}" />
                                <Button Grid.Column="1" Command="{Binding ChangeDestinationCommand}"
                                        AutomationProperties.Name="{Binding [Devices.ChangeFolder], Source={x:Static loc:Localizer.Instance}}"
                                        ToolTip.Tip="{Binding [Devices.ChangeFolder], Source={x:Static loc:Localizer.Instance}}">
                                    <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding StartWithSystem}"
                              Content="{Binding [Devices.StartWithSystem], Source={x:Static loc:Localizer.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Dispositivos confiáveis -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <icons:MaterialIcon Grid.Column="0" Kind="Devices" Width="20" Height="20"
                                            Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="section" VerticalAlignment="Center"
                                   Text="{Binding [Devices.Trusted], Source={x:Static loc:Localizer.Instance}}" />
                        <Button Grid.Column="2" Classes="icon" Command="{Binding RefreshOnlineCommand}"
                                AutomationProperties.Name="{Binding [Devices.Refresh], Source={x:Static loc:Localizer.Instance}}"
                                ToolTip.Tip="{Binding [Devices.Refresh], Source={x:Static loc:Localizer.Instance}}">
                            <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <TextBlock Classes="hint" IsVisible="{Binding !HasDevices}"
                               Text="{Binding [Devices.TrustedEmpty], Source={x:Static loc:Localizer.Instance}}" />

                    <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding HasDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrustedDeviceItem">
                                <Border Background="{DynamicResource SubtleBackgroundBrush}" CornerRadius="12" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <icons:MaterialIcon Grid.Column="0" Kind="Laptop" Width="22" Height="22" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="hint" Text="{Binding PairedText}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="pill success" IsVisible="{Binding IsOnline}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OnlineText}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding OnlineText}" IsVisible="{Binding !IsOnline}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Classes="icon" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding [Devices.Remove], Source={x:Static loc:Localizer.Instance}}"
                                                ToolTip.Tip="{Binding [Devices.Remove], Source={x:Static loc:Localizer.Instance}}">
                                            <icons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Adicionar dispositivo: digita o código do outro computador e pareia -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{Binding [Devices.Add], Source={x:Static loc:Localizer.Instance}}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding PairCode}" PlaceholderText="XXX-XXX-XXXX-XXXX"
                                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{Binding [Devices.Add], Source={x:Static loc:Localizer.Instance}}" />
                            <Button Grid.Column="1" Classes="primary" Command="{Binding PairCommand}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding [Devices.Pair], Source={x:Static loc:Localizer.Instance}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [Devices.Pair], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Classes="hint" Text="{Binding [Devices.AddHint], Source={x:Static loc:Localizer.Instance}}" />
                        <TextBlock Text="{Binding PairStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Atividade recente do receive mode -->
            <Border Classes="card" IsVisible="{Binding HasActivity}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="{Binding [Devices.Activity], Source={x:Static loc:Localizer.Instance}}" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
