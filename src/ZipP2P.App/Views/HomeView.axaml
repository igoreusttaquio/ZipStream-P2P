<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZipP2P.App.ViewModels"
             xmlns:views="using:ZipP2P.App.Views"
             xmlns:loc="using:ZipP2P.App.Localization"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="660"
             x:Class="ZipP2P.App.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             DragDrop.AllowDrop="True">

    <!-- Abas: Enviar / Receber / Ferramentas. Arrastar um item para a janela seleciona-o para envio. -->
    <TabControl Classes="main" SelectedIndex="{Binding SelectedTab}" Padding="0,12,0,0">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [Mode.Send], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <views:SendView DataContext="{Binding Send}" />
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [Mode.Receive], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <views:ReceiveView DataContext="{Binding Receive}" />
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Tools" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [Tools.Title], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <views:ToolsView DataContext="{Binding Tools}" />
        </TabItem>
    </TabControl>
</UserControl>
